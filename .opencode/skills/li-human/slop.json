  "structures": [
    {
      "id": "not-just",
      "regex": "(?i)\\bit'?s not (?:just|only) [^.!?\\n]{2,60}[,.] it'?s\\b",
      "name": "\"It's not just X, it's Y\"",
      "fix": "Say the one thing you actually mean. Delete the setup half."
    },
    {
      "id": "not-only",
      "regex": "(?i)\\bnot only\\b[^.!?\\n]{2,80}\\bbut also\\b",
      "name": "\"Not only X but also Y\"",
      "fix": "Split into two sentences, or drop the weaker half."
    },
    {
      "id": "isnt-about",
      "regex": "(?i)\\b(?:this|it) is(?:n'?t| not) about [^.!?\\n]{2,60}[.!] it'?s about\\b",
      "name": "\"It isn't about X. It's about Y.\"",
      "fix": "Lead with Y. The reversal is the tell."
    },
    {
      "id": "the-result",
      "regex": "(?i)^\\s*(?:the result|the best part|the kicker|the catch)\\?\\s*$",
      "name": "One-word rhetorical question line",
      "fix": "Answer it inline instead of staging a reveal."
    },
    {
      "id": "heres-what",
      "regex": "(?i)\\bhere'?s what (?:i|we) learned\\b",
      "name": "\"Here's what I learned\"",
      "fix": "State the lesson. Skip the announcement."
    },
    {
      "id": "triad",
      "regex": "(?i)\\b\\w+, \\w+, and \\w+\\.",
      "name": "Rule-of-three triad",
      "fix": "Two items or four. Three is the model's default rhythm."
    },
    {
      "id": "rocket",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF]",
      "name": "Rocket / fire / bulb / sparkle / dart emoji",
      "fix": "One emoji max, and not one of these five."
    },
    {
      "id": "hashtag-wall",
      "regex": "(?:#\\w+[ \\t]*){5,}",
      "name": "Hashtag wall (5+)",
      "fix": "Three hashtags. LinkedIn stopped rewarding the wall."
    },
    {
      "id": "as-an-ai",
      "regex": "(?i)\\bas an ai\\b|\\bas a language model\\b",
      "name": "Model self-reference",
      "fix": "Delete the sentence."
    },
    {
      "id": "in-summary",
      "regex": "(?i)^\\s*(?:in summary|to summarize|in conclusion)\\b",
      "name": "Essay-closer opener",
      "fix": "A post does not need a conclusion paragraph."
    },
    {
      "id": "engagement-bait",
      "regex": "(?i)\\b(?:agree\\?|thoughts\\?|who else\\b|am i wrong\\?)\\s*$",
      "name": "Reflex engagement bait",
      "fix": "Ask a question only you could ask, about the specific thing above it."
    },
    {
      "id": "no-es-solo",
      "regex": "(?i)\\bno (?:es|fue) (?:solo|solamente|únicamente)\\b[^.!?\\n]{2,60}[,.]\\s*(?:es|fue|sino)\\b",
      "name": "\"No es solo X, es Y\"",
      "fix": "Di directamente la parte Y. La primera mitad solo prepara el giro."
    },
    {
      "id": "no-solo-sino",
      "regex": "(?i)\\bno solo\\b[^.!?\\n]{2,80}\\bsino (?:que )?tambi[?e]n\\b",
      "name": "\"No solo X, sino también Y\"",
      "fix": "Parte la frase en dos o quita la mitad más débil."
    },
    {
      "id": "no-se-trata-de",
      "regex": "(?i)\\bno (?:se trata|va) de\\b[^.!?\\n]{2,60}[.!]\\s*(?:se trata|va) de\\b",
      "name": "\"No se trata de X. Se trata de Y.\"",
      "fix": "Empieza por Y. La vuelta atrás es el aviso."
    },
    {
      "id": "titular-el-resultado",
      "regex": "(?i)^\\s*¿?(?:el resultado|lo mejor|la clave|el truco|la trampa|el problema)\\?\\s*$",
      "name": "Línea de pregunta retórica de una palabra",
      "fix": "Respóndela en la misma línea en vez de preparar un misterio."
    },
    {
      "id": "aqui-esta-lo-que",
      "regex": "(?i)\\baquí (?:está|están|va|van) (?:lo|la|el|los|las) que (?:aprendí|aprendimos|saqué|sacamos)\\b",
      "name": "\"Aquí está lo que aprendí\"",
      "fix": "Escribe el aprendizaje. Sobra el anuncio."
    },
    {
      "id": "triada",
      "regex": "(?i)\\b\\w+, \\w+ y \\w+[.!]",
      "name": "Tríada de tres elementos",
      "fix": "Dos elementos o cuatro. Tres es el ritmo por defecto del modelo."
    },
    {
      "id": "como-ia",
      "regex": "(?i)\\bcomo (?:una )?ia\\b(?=\\s*,)|\\bcomo (?:modelo de lenguaje|modelo lingüístico|asistente de ia)\\b",
      "name": "Autorreferencia al modelo",
      "fix": "Borra la frase."
    },
    {
      "id": "en-resumen",
      "regex": "(?i)(?:^|[.!?]\\s+)\\s*(?:en resumen|en conclusi?n|para resumir|resumiendo)\\b",
      "name": "Apertura de cierre de redacción",
      "fix": "Un post no necesita párrafo de conclusión."
    },
    {
      "id": "cierre-generico",
      "regex": "(?i)\\b(?:estás de acuerdo|piensas lo mismo|qué opinas|no crees|tú qué crees|y tú)\\s*\\?\\s*$",
      "name": "Cierre genérico de interacción",
      "fix": "Pregunta algo que solo tú puedas preguntar sobre lo de arriba."
    },
    {
      "id": "lo-que-nadie-te-cuenta",
      "regex": "(?i)\\blo que nadie te (?:cuenta|dice|enseña|ha contado)\\b",
      "name": "\"Lo que nadie te cuenta\"",
      "fix": "Cuenta el dato concreto en vez de prometer el secreto."
    },
    {
      "id": "en-un-mundo-donde",
      "regex": "(?i)\\ben un mundo (?:donde|cada vez más)\\b",
      "name": "\"En un mundo donde...\"",
      "fix": "Empieza por el hecho, no por el decorado."
    },
    {
      "id": "dejame-contarte",
      "regex": "(?i)\\bdéjame (?:contarte|contaros|explicarte)\\b",
      "name": "\"Déjame contarte\"",
      "fix": "Cuéntalo. El anuncio previo sobra."
    },
